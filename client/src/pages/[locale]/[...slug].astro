---
import { useTranslations } from "../../i18n/utils";
import { ui, languages } from "../../i18n/ui";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getCollection } from "astro:content";
import RenderDocument from "../../components/ui/RenderDocument.astro";
import { getVersion } from "../../config/versions";

// v1 (current default) lives at the root: /{locale}/{...slug}
// Content for this route is in client/src/content/v1/{locale}/...

const lang = Astro.params.locale;
const t = useTranslations(lang as keyof typeof ui);

export async function getStaticPaths() {
  const allDocs = await getCollection("docs");
  const v1Docs = allDocs.filter((doc) => doc.id.startsWith("v1/"));

  return [
    // Bare /{locale} (no slug) — handled below by redirect to v1 root.
    ...Object.keys(languages).map((locale) => ({
      params: { locale },
      props: { doc: null },
    })),
    // Legacy path redirects (keep old URLs working without keeping old docs in the sidebar)
    ...Object.keys(languages).flatMap((locale) => [
      {
        params: { locale, slug: "getting-started/context-engineers" },
        props: { doc: null },
      },
    ]),
    ...v1Docs.map((doc) => {
      const parts = doc.id.split("/");
      // doc.id = v1/{locale}/{slug...}
      const locale = parts[1];
      const slug = parts.slice(2).join("/");
      return {
        params: { locale, slug },
        props: { doc },
      };
    }),
  ];
}

const { doc } = Astro.props;
const slug = Astro.params.slug;
const version = getVersion("v1")!;

// Legacy redirects
if (slug === "getting-started/context-engineers") {
  return Astro.redirect(`/${lang}/getting-started/developers`);
}

// Redirect to version root if no document is found (e.g. when visiting /en)
if (!doc) {
  return Astro.redirect(`/${lang}/${version.root}`);
}
---

<DocsLayout title={doc.data.title} doc={doc} version="v1">
  <RenderDocument doc={doc} />
</DocsLayout>
