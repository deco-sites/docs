---
import { useTranslations } from "../../../i18n/utils";
import { ui, languages } from "../../../i18n/ui";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { getCollection } from "astro:content";
import RenderDocument from "../../../components/ui/RenderDocument.astro";
import { getVersion } from "../../../config/versions";

// v2 lives under /v2/{locale}/{...slug}
// Content for this route is in client/src/content/v2/{locale}/...

const lang = Astro.params.locale;
const t = useTranslations(lang as keyof typeof ui);

export async function getStaticPaths() {
  const allDocs = await getCollection("docs");
  const v2Docs = allDocs.filter((doc) => doc.id.startsWith("v2/"));

  return [
    ...Object.keys(languages).map((locale) => ({
      params: { locale },
      props: { doc: null },
    })),
    ...v2Docs.map((doc) => {
      const parts = doc.id.split("/");
      const locale = parts[1];
      const slug = parts.slice(2).join("/");
      return {
        params: { locale, slug },
        props: { doc },
      };
    }),
  ];
}

const { doc } = Astro.props;
const version = getVersion("v2")!;

// Redirect to version root if no document is found (e.g. when visiting /v2/en)
if (!doc) {
  return Astro.redirect(`/v2/${lang}/${version.root}`);
}
---

<DocsLayout title={doc.data.title} doc={doc} version="v2">
  <RenderDocument doc={doc} />
</DocsLayout>
